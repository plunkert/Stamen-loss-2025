# Counts come from a 0.671 mm^2 area
dat$abStom <- dat$abStom/0.671
dat$adStom <- dat$adStom/0.671
# Make variables that should be numeric actually numeric
dat$leafL <- as.numeric(dat$leafL)
dat$longestFBL <- as.numeric(dat$longestFBL)
# Make format for anthocyanin scoring consistent
dat$abLeafAnth <- as.factor(toupper(dat$abLeafAnth))
dat$abVeinsAnth <- as.factor(toupper(dat$abVeinsAnth))
dat$stemAnth <- as.factor(toupper(dat$stemAnth))
table(dat$abLeafAnth)
table(dat$abVeinsAnth)
table(dat$stemAnth)
# There are only 5 plants w/o stem anthocyanins, three of which are from the same family. Let's not pursue
# that trait further.
# High vs. low is kind of unreliable. For leaf traits, change to TRUE if High or Low, or FALSE if Absent.
dat$abLeafAnth <- (dat$abLeafAnth !="A")
dat$abVeinsAnth <- (dat$abVeinsAnth !="A")
# you can have the leaf lamina pigmented excluding the veins, but not veins only.
# Recode calyx spots as present TRUE /absent FALSE.
dat$calyxSpots <- (dat$calyxSpots=="Y")
# Let's check whether each anthocyanin trait is associated with life history
table(dat$abLeafAnth, dat$life.history) #annuals always have abaxial leaf anthocyanins
table(dat$abVeinsAnth, dat$life.history) # leaf veins don't predict calyx spots
table(dat$calyxSpots, dat$life.history) # annuals never have calyx spots
# with site?
table(dat$abLeafAnth, dat$site) #annuals always have abaxial leaf anthocyanins
table(dat$abVeinsAnth, dat$site) # laguna lake plants don't usually have abaxial vein pigment
table(dat$calyxSpots, dat$site) # South Hills plants never have calyx spots
# with site and life history?
table(dat$abLeafAnth, dat$life.history, dat$site) #annuals always have abaxial leaf anthocyanins
table(dat$abVeinsAnth, dat$life.history, dat$site)
table(dat$calyxSpots, dat$life.history, dat$site) # Only Laguna Lake perennials have calyx spots
# Is variance among families in flowering time significant?
varAmongFam <- lm(as.numeric(dat$floweringTime) ~ dat$family)
anova(varAmongFam)
tab <- as.data.frame(table(dat$family))
threes <- tab[which(tab$Freq == 3),]
dat3 <- dat[dat$family %in% threes$Var1,]
varAmongFam3 <- lm(as.numeric(dat3$floweringTime) ~ dat3$family)
anova(varAmongFam3)
aov(varAmongFam)
aov(varAmongFam3)
# Removing columns where we expect a lot of NAs (e.g. notes columns)
dat <- subset(dat, select = -c(notes.dff, notes.2w, notes.anth, notes.rhizome, longestStolonL, lenLongestR))
# Compute family means for everything
means <- dat %>%
group_by(dat$family) %>%
summarize(
floweringTime = mean(floweringTime, na.rm=TRUE),
node.ff = mean(node.ff, na.rm=TRUE),
internodeL = mean(internodeL, na.rm=TRUE),
stemW = mean(stemW, na.rm=TRUE),
leafL = mean(leafL, na.rm=TRUE),
calyxL = mean(calyxL, na.rm=TRUE),
corW = mean(corW, na.rm=TRUE),
corL = mean(corL, na.rm=TRUE),
height.dff = mean(height.dff, na.rm=TRUE),
pedicelL = mean(pedicelL, na.rm=TRUE),
stolonNum = mean(stolonNum, na.rm=TRUE),
fbNum = mean(fbNum, na.rm=TRUE),
longestFBL = mean(longestFBL, na.rm=TRUE),
height2wk = mean(height2wk, na.rm=TRUE),
flowerNum = mean(flowerNum, na.rm=TRUE),
sla = mean(sla, na.rm=TRUE),
rhizomeNum = mean(rhizomeNum, na.rm=TRUE),
rBiomass = mean(rBiomass, na.rm=TRUE),
ableafAnth=mean(abLeafAnth, na.rm=TRUE),
abVeinsAnth=mean(abVeinsAnth, na.rm=TRUE),
abStom=mean(abStom, na.rm=TRUE),
adStom=mean(adStom, na.rm=TRUE),
calyxSpots=mean(calyxSpots, na.rm=TRUE),
)
names(means)[names(means) == 'dat$family'] <- 'family'
means$site <- as.factor(substring(means$family, 1, 2))
means$life.history <- as.factor(substring(means$family, 4,4))
# Plot family means on a PCA biplot
pca <- prcomp(means[,c(2:19,22,23)], scale. = TRUE)
#reverse the signs
pca$rotation <- -1*pca$rotation
#display PCs
pca$rotation
#reverse the signs of the scores
pca$x <- -1*pca$x
# How much variance explained?
summary(pca) # 40.5% by PC1, 18.1% by PC2, 8.1% by PC3, 5.4% by PC4. 73.0% by first 4 PCs
# get PC loadings plot
biplot(pca, scale = 0, xlabs = rep("", nrow(means)))
# prettier PC loadings
arrow_style = arrow(
angle = 20, length = grid::unit(8, "pt"),
ends = "first", type = "closed"
)
pca %>%
# extract rotation matrix
tidy(matrix = "rotation") %>%
pivot_wider(
names_from = "PC", values_from = "value",
names_prefix = "PC"
) %>%
ggplot(aes(PC1, PC2)) +
geom_segment(
xend = 0, yend = 0,
arrow = arrow_style
) +
geom_text_repel(aes(label = column), hjust = 1, force=6, force_pull=0.1) +
xlim(-1, 1) + ylim(-1, 1) +
coord_fixed()
# add PCs to dataframe
pca.dat <- as.data.frame(pca$x)
means <- cbind(means, pca.dat)
# add indicator variable for site/life history combination
means$site.life.history <- as.factor(substring(as.character(means$family), 1, 4))
# PC by PC biplots
# PC1 by PC2, color by site and life history
means %>%
ggplot() +
aes(PC1, PC2) +
geom_point(aes(color = site.life.history))
rm(list=ls())
# load required packages
require(ggplot2)
