pen.tk.norm.scantwo.0.01 <- calc.penalties(out.tk.norm.scan2.perm, alpha = 0.01)
pen.tk.ov.scantwo.0.01 <- calc.penalties(out.tk.ov.scan2.perm, alpha = 0.01)
